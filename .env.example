# 纯文本模型 — 可选: deepseek
TEXT_PROVIDER=deepseek

# 多模态模型 — 可选: doubao / kimi
MULTIMODAL_PROVIDER=doubao

# DeepSeek — 纯文本
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=sk-your-key

# 豆包（火山方舟）— 多模态
DOUBAO_MODEL=doubao-1-5-vision-pro-32k-250115
VOLCANO_API_KEY=sk-your-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# Kimi K3 — 多模态
KIMI_MODEL=kimi-k3
KIMI_API_KEY=sk-your-key
KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions

# GPT — 多模态
GPT_MODEL=gpt-5.6-sol
GPT_API_KEY=sk-your-key
GPT_BASE_URL=https://api.sudocode.chat/v1/chat/completions
GPT_PROXY=http://127.0.0.1:7890

# Seedream — 生图
SEEDREAM_IMAGE_MODEL=doubao-seedream-4-5-251128
SEEDREAM_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
IMAGE_MAX_CONCURRENT=3

# Seedance — 图生视频
SEEDANCE_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
SEEDANCE_VIDEO_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks

# 基础设施
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/ecommerce_unified

# 爬虫
PROXY_PROVIDER=none  # none / free / brightdata
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
ALIBABA_1688_EMAIL=
ALIBABA_1688_PASSWORD=
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
